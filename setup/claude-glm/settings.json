  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sinep/.claude-glm/hooks/danger-guard.sh",
            "statusMessage": "Guardrail: checking command"
          },
          {
            "type": "command",
            "command": "/home/sinep/.claude-glm/hooks/sudo-timestamp-gate.sh",
            "statusMessage": "Checking sudo timestamp window"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sinep/.claude-glm/hooks/auto-format.sh",
            "statusMessage": "Auto-formatting edit"
          },
          {
            "type": "command",
            "command": "/home/sinep/.claude-glm/hooks/verify-check.sh",
            "statusMessage": "Verify gate"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/sinep/.claude-glm/hooks/statusline.sh"
  },
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true
}
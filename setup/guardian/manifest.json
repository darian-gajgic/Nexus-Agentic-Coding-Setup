    },
    {
      "path": "command_allowlist",
      "reason": "removed 2026-07-06 (remediation S1/C4): the two category entries auto-approved every interpreter -e/-c/heredoc unprompted; an 'always' answer at a future approval prompt regrows this key \u2014 treat any reappearance as drift and re-review"
    }
  ],
  "skills_disabled_must_exclude": [

      "import": "ollama"
    },
    {
      "spec": "mem0ai==2.0.10",
      "import": "mem0"
    },
    {
      "spec": "qdrant-client==1.18.0",
      "import": "qdrant_client"
    }
  ],
  "services": [
    {
      "unit": "hermes-gateway.service",
      "scope": "user",
      "restorable": false,
      "note": "Hermes-managed"
    },
    {
      "unit": "nexus.service",
      "scope": "user",
      "restorable": true
    },
    {
      "unit": "hermes-guardian.timer",
      "scope": "user",
      "restorable": true
    },
    {
      "unit": "docker.service",
      "scope": "system",
      "restorable": false,
      "note": "check only; Langfuse depends on it"
    },
    {
      "unit": "hermes-reflect.timer",
      "scope": "user",
      "restorable": true
    },
    {
      "unit": "hermes-prune.timer",
      "scope": "user",
      "restorable": true
    }
  ],
  "notes": [
    "Config values SURVIVE hermes update (deep-merge); guardian verifies + reports drift.",
    "Files SURVIVE update but guardian restores from golden/ if ever deleted.",
    "Packages langfuse+ollama are NOT in the lockfile; a VENV REBUILD prunes them -> guardian reinstalls.",
    "nexus edits are committed to git (e141022); guardian checks the service + files, not git.",
    "mem0 uses qdrant SERVER mode (localhost:6333, docker, restart:always) so nexus can read memories concurrently; embedded store kept at ~/.hermes/mem0_qdrant as a backup."
  ],
  "containers": [
    {
      "name": "qdrant",
      "compose_dir": "~/qdrant",
      "ready_url": "http://localhost:6333/readyz"
    },
    {
      "name": "langfuse-web",
      "compose_dir": "~/langfuse",
      "ready_url": "http://localhost:3000/api/public/health"
    }
  ],
  "skills_disabled_enforce": true

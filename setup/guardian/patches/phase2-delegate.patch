+def _log_specialist_completion(specialist, goal, outcome):
+    """Append a completed SPECIALIST task to the reflector log (fail-soft).
+
+    The offline reflector (~/.hermes/scripts/reflect.py) reads this to draft
+    candidate lessons for human approval in nexus. Only specialist children are
+    logged; dynamic subagents are not.
+    """
+    if not specialist:
+        return
+    try:
+        import datetime as _dt
+        d = os.path.expanduser("~/.hermes/agents")
+        os.makedirs(d, exist_ok=True)
+        with open(os.path.join(d, ".reflection_log.jsonl"), "a") as _f:
+            _f.write(json.dumps({
+                "specialist": specialist,
+                "goal": (goal or "")[:600],
+                "outcome": (outcome or "")[:2000],
+                "ts": _dt.datetime.now().isoformat(timespec="seconds"),
+            }) + "\n")
+    except Exception as e:
+        # Fail-soft, not fail-mute: a broken reflector feed must be visible.
+        logger.warning("reflection-log append failed for %r: %s", specialist, e)
+

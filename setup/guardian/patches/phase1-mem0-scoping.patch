+    def _is_specialist(self) -> bool:
+        return bool(self._agent_id) and self._agent_id != self._shared_agent_id
+
+    @staticmethod
+    def _merge_scoped(primary, secondary, limit):
+        """Merge two result lists — role-private first — dedup by id, cap to limit."""
+        seen, out = set(), []
+        for r in list(primary) + list(secondary):
+            rid = r.get("id")
+            if rid is not None and rid in seen:
+                continue
+            if rid is not None:
+                seen.add(rid)
+            out.append(r)
+            if len(out) >= limit:
+                break
+        return out
+
+    def _scoped_search(self, query, top_k, rerank, backend=None):
+        """Two-scope recall for specialists: role-private first, then the shared
+        base (agent_id == shared). The primary/base agent keeps the wider
+        user_id-only recall unchanged (zero regression)."""
+        backend = backend or self._backend
+        if backend is None:
+            return []
+        if not self._is_specialist():
+            return backend.search(query, filters=self._read_filters(), top_k=top_k, rerank=rerank) or []
+        priv = backend.search(query, filters={"user_id": self._user_id, "agent_id": self._agent_id}, top_k=top_k, rerank=rerank) or []
+        base = backend.search(query, filters={"user_id": self._user_id, "agent_id": _TEAM_SHARED}, top_k=top_k, rerank=rerank) or []
+        _log_lesson_usage([r.get("id") for r in priv])  # track this specialist's own lessons that surface
+        return self._merge_scoped(priv, base, top_k)
+
+    def _scoped_get_all(self, page, page_size):
+        """Two-scope listing for specialists: role-private + shared base merged."""
+        backend = self._backend
+        if not self._is_specialist():
+            return backend.get_all(filters=self._read_filters(), page=page, page_size=page_size)
+        priv = backend.get_all(filters={"user_id": self._user_id, "agent_id": self._agent_id}, page=page, page_size=page_size)
+        base = backend.get_all(filters={"user_id": self._user_id, "agent_id": _TEAM_SHARED}, page=page, page_size=page_size)
+        merged = self._merge_scoped(priv.get("results", []), base.get("results", []), page_size)
+        return {"results": merged, "count": priv.get("count", 0) + base.get("count", 0)}
+

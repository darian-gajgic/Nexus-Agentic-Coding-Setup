+def _log_lesson_usage(ids):
+    """Best-effort append of retrieved specialist-lesson ids so the pruning job
+    (~/.hermes/scripts/prune_lessons.py) can retire lessons that go old + unused."""
+    ids = [i for i in (ids or []) if i]
+    if not ids:
+        return
+    try:
+        import datetime as _dt
+        d = os.path.expanduser("~/.hermes/agents")
+        os.makedirs(d, exist_ok=True)
+        with open(os.path.join(d, ".lesson_usage.jsonl"), "a") as _f:
+            _f.write(json.dumps({"ids": ids, "ts": _dt.datetime.now().isoformat(timespec="seconds")}) + "\n")
+    except Exception:
+        pass
 
 

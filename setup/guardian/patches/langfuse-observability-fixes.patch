+def _mget(obj: Any, key: str) -> Any:
+    """Attribute-or-key access so both objects and dict-shaped messages work."""
+    if isinstance(obj, dict):
+        return obj.get(key)
+    return getattr(obj, key, None)
+
+
+def _reasoning_details_text(details: Any) -> Optional[str]:
+    """Flatten a ``reasoning_details`` list into a single string.
+
+    Shape: ``[{"type": "reasoning.text", "text": "..."}, ...]``. Recognised text
+    keys, in order: ``text`` (OpenRouter unified), ``thinking`` (Anthropic-shaped
+    blocks), ``summary`` / ``content`` (other providers). Returns None when there
+    is nothing usable.
+    """
+    if not isinstance(details, (list, tuple)):
+        return None
+    parts = []
+    for item in details:
+        if isinstance(item, dict):
+            piece = (
+                item.get("text")
+                or item.get("thinking")
+                or item.get("summary")
+                or item.get("content")
+            )
+            if isinstance(piece, str) and piece.strip():
+                parts.append(piece)
+    return "\n\n".join(parts) if parts else None
+
+
+def _extract_reasoning(message: Any) -> Optional[str]:
+    """Best-effort chain-of-thought text from an assistant message, or None.
+
+    Providers disagree on where reasoning lives, and Hermes' chat transport keeps
+    ``reasoning`` distinct from ``reasoning_content`` / ``reasoning_details``:
+
+      * Anthropic / Gemini / Bedrock            -> ``message.reasoning``
+      * GLM (Z.AI) / DeepSeek / Moonshot (Kimi) -> ``message.reasoning_content``
+      * OpenRouter unified                      -> ``message.reasoning_details`` (list)
+
+    ``NormalizedResponse`` carries the latter two in ``provider_data`` and
+    re-exposes them via ``.reasoning_content`` / ``.reasoning_details`` properties,
+    so a plain ``getattr(message, "reasoning", None)`` silently misses GLM /
+    DeepSeek / Kimi thinking — the bug this fixes. Check every known location in
+    precedence order. Fail-open (never raise): observability must not break a turn.
+    """
+    try:
+        # 1. Native single-field reasoning (already-normalized providers).
+        reasoning = _mget(message, "reasoning")
+        if isinstance(reasoning, str) and reasoning.strip():
+            return reasoning
+
+        # 2. reasoning_content — NormalizedResponse property, raw SDK attr, or key
+        #    (GLM/Z.AI, DeepSeek, Moonshot/Kimi thinking mode).
+        rc = _mget(message, "reasoning_content")
+        if isinstance(rc, str) and rc.strip():
+            return rc
+
+        # 3. reasoning_details (OpenRouter unified) — property, attr, or key.
+        text = _reasoning_details_text(_mget(message, "reasoning_details"))
+        if text:
+            return text
+
+        # 4. provider_data passthrough (defensive: a pre-property NormalizedResponse
+        #    or a raw dict that carries provider_data).
+        pd = _mget(message, "provider_data")
+        if isinstance(pd, dict):
+            rc = pd.get("reasoning_content")
+            if isinstance(rc, str) and rc.strip():
+                return rc
+            text = _reasoning_details_text(pd.get("reasoning_details"))
+            if text:
+                return text
+
+        # 5. pydantic ``model_extra`` passthrough (OpenAI SDK objects stash unknown
+        #    fields here; some proxies deliver reasoning_content this way).
+        model_extra = _mget(message, "model_extra")
+        if isinstance(model_extra, dict):
+            rc = model_extra.get("reasoning_content")
+            if isinstance(rc, str) and rc.strip():
+                return rc
+            r = model_extra.get("reasoning")
+            if isinstance(r, str) and r.strip():
+                return r
+    except Exception:  # pragma: no cover - fail-open
+        return None
+    return None
+
+
 def _serialize_assistant_message(message: Any) -> dict[str, Any]:
     return {
         "content": _safe_value(getattr(message, "content", None)),
-        "reasoning": _safe_value(getattr(message, "reasoning", None)),
+        # Read reasoning from every provider location, not just ``.reasoning``:
+        # GLM/Z.AI, DeepSeek and Kimi return it in ``reasoning_content`` (kept in
+        # NormalizedResponse.provider_data), which the plain attribute read missed.
+        "reasoning": _safe_value(_extract_reasoning(message)),
         "tool_calls": _serialize_tool_calls(getattr(message, "tool_calls", None)),
     }
 

+        # NEXUS CORE-MOD (session-model): honor the per-session stored model.
+        # api_server sessions are created with an explicit ``model`` (Nexus
+        # per-task models, JARVIS sessions, overload-fallback sessions) but
+        # upstream only ever runs the config.yaml default for session turns.
+        # Precedence (highest first): session /model override > per-turn
+        # route/model > stored session model > global config. Sessions created
+        # without an explicit model store the advertised ``_model_name``
+        # placeholder — skip those so they keep following the global default.
+        if session_id and not session_override and not (route and route.get("model")):
+            try:
+                _sdb = self._ensure_session_db()
+                _srow = _sdb.get_session(session_id) if _sdb else None
+                _stored = (_srow or {}).get("model")
+                if _stored and _stored != self._model_name:
+                    model = _stored
+                    logger.debug(
+                        "api_server session stored model applied: session=%s model=%s",
+                        session_id, model,
+                    )
+            except Exception:
+                logger.debug("session stored-model lookup failed", exc_info=True)
+

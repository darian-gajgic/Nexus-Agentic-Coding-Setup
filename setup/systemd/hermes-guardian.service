[Unit]
Description=Hermes Guardian - verify & restore hardening changes after updates/reboots
After=hermes-gateway.service

[Service]
Type=oneshot
Environment=PATH=/home/sinep/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/sinep/.hermes/hermes-agent/venv/bin/python /home/sinep/hermes-guardian/guardian.py

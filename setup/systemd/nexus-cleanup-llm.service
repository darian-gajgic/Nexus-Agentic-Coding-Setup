[Unit]
Description=nexus cleanup LLM — isolated Ollama (f16 KV cache) for dictation post-processing
After=graphical-session.target

[Service]
Type=simple
# A SECOND, fully-isolated Ollama: own port, own models dir, and a NORMAL (f16) KV cache.
# The system Ollama uses q4_0 KV cache which garbles small models; this instance doesn't,
# so gemma3:4b produces correct transcript cleanup. Nothing here touches the system
# ollama.service, its models, or its config.
# (Renamed from WisprFlow's wf-cleanup-llm.service in the 2026-07-10 STT consolidation —
# same models dir ~/.ollama-wf so nothing re-downloads and rollback still works.
# keep_alive dropped 5m -> 2m: the cleanup model frees its ~2.9GB of the shared 12GB
# card sooner; dictation also sends keep_alive per-request via dictation.llm_keep_alive.)
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=%h/.ollama-wf/models
Environment=OLLAMA_KV_CACHE_TYPE=f16
Environment=OLLAMA_FLASH_ATTENTION=0
Environment=OLLAMA_KEEP_ALIVE=2m
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

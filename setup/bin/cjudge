#!/usr/bin/env bash
# cjudge — frontier Claude judges a deliverable against a domain rubric.
# Part of the GLM<->Claude bridge (docs: ~/knowledge/WORKFLOW.md).
# Usage: cjudge <file> <domain>
set -euo pipefail

KNOW="$HOME/knowledge"
FILE="${1:-}"; DOMAIN="${2:-}"

if [ -z "$FILE" ] || [ -z "$DOMAIN" ]; then
  echo "usage: cjudge <file> <domain>" >&2
  echo "domains:" >&2; ls "$KNOW/domains" >&2
  exit 1
fi

FILE="$(realpath "$FILE")"
[ -f "$FILE" ] || { echo "cjudge: no such file: $FILE" >&2; exit 1; }
RUBRIC="$KNOW/domains/$DOMAIN/RUBRIC.md"
[ -f "$RUBRIC" ] || { echo "cjudge: unknown domain '$DOMAIN'. Available:" >&2; ls "$KNOW/domains" >&2; exit 1; }

PROMPT="You are the frontier judge — a second, stronger model reviewing work produced by a weaker one. Judge the deliverable at $FILE against the rubric at $RUBRIC.

Steps:
1. Read $FILE, $RUBRIC, $KNOW/BUSINESS-CONTEXT.md, and $KNOW/STYLE-VOICE.md.
2. Must-pass gates: list each gate PASS/FAIL, one-line reason for every FAIL.
3. Scored dimensions: score each 0-4 with a one-line justification.
4. Kill-list scan: quote any hits verbatim.
5. Top 3 highest-leverage improvements — concrete edits (quote the before, give the after), not vibes.
6. VERDICT: SHIP | REVISE (list exactly what blocks) | REWRITE (why salvaging is worse than restarting).
7. End with one 'Learning note:' line for the junior humans — the single most instructive gap between this and professional work.

Be adversarial and specific. Do NOT rewrite the whole deliverable. Do NOT modify any files."

# Nexus Settings v2 hooks (both optional, absent = original behavior):
#   JUDGE_MODEL              — explicit judge model (Settings → Models & routing,
#                              'frontier judge' purpose) → claude --model
#   JUDGE_ANTHROPIC_API_KEY  — per-user Anthropic key; when set, the call runs
#                              key-authed instead of the CLI's subscription auth
MODEL_ARGS=()
if [ -n "${JUDGE_MODEL:-}" ]; then MODEL_ARGS=(--model "$JUDGE_MODEL"); fi

KEY_ENV=(-u ANTHROPIC_API_KEY)
if [ -n "${JUDGE_ANTHROPIC_API_KEY:-}" ]; then
  KEY_ENV=(ANTHROPIC_API_KEY="$JUDGE_ANTHROPIC_API_KEY")
fi

# NOTE: env requires -u options BEFORE NAME=VALUE assignments — KEY_ENV
# (either `-u ANTHROPIC_API_KEY` or `ANTHROPIC_API_KEY=…`) must come last.
exec env -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES -u ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES \
  -u CLAUDE_CONFIG_DIR -u CLAUDE_CODE_SUBAGENT_MODEL -u CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY \
  -u CLAUDE_CODE_EFFORT_LEVEL -u CLAUDE_CODE_AUTO_COMPACT_WINDOW -u CLAUDE_CODE_WORKFLOWS \
  -u CLAUDE_CODE_ALWAYS_ENABLE_EFFORT -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -u API_TIMEOUT_MS \
  -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT \
  "${KEY_ENV[@]}" \
  claude "${MODEL_ARGS[@]}" -p "$PROMPT"

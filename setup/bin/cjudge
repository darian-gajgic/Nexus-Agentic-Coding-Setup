#!/usr/bin/env bash
# cjudge — frontier Claude judges a deliverable against a domain rubric.
# Part of the GLM<->Claude bridge (docs: ~/knowledge/WORKFLOW.md).
# Usage: cjudge <file> <domain>
set -euo pipefail

KNOW="$HOME/knowledge"
FILE="${1:-}"; DOMAIN="${2:-}"

if [ -z "$FILE" ] || [ -z "$DOMAIN" ]; then
  echo "usage: cjudge <file> <domain>" >&2
  echo "domains:" >&2; ls "$KNOW/domains" >&2
  exit 1
fi

FILE="$(realpath "$FILE")"
[ -f "$FILE" ] || { echo "cjudge: no such file: $FILE" >&2; exit 1; }
RUBRIC="$KNOW/domains/$DOMAIN/RUBRIC.md"
[ -f "$RUBRIC" ] || { echo "cjudge: unknown domain '$DOMAIN'. Available:" >&2; ls "$KNOW/domains" >&2; exit 1; }

# N1 (Super Result): optional deliverable-TYPE rubric — when Nexus resolves one
# (e.g. rubrics/INVESTIGATION.md for analysis work) the judge grades against
# BOTH rubrics; every must-pass gate binds regardless of which rubric owns it.
TYPE_RUBRIC_BLOCK=""
if [ -n "${JUDGE_TYPE_RUBRIC:-}" ] && [ -f "${JUDGE_TYPE_RUBRIC:-}" ]; then
  TYPE_RUBRIC_BLOCK="Additionally read the deliverable-TYPE rubric at $JUDGE_TYPE_RUBRIC and grade against BOTH rubrics — its must-pass gates (e.g. verified-not-inferred) bind exactly like the domain rubric's."
fi

# Judge-scope fix (2026-07-12): when Nexus passes a STAGE contract, it is the
# binding criteria set for this deliverable — the deliverable is ONE STAGE of a
# larger plan, and project-level criteria owned by later stages must not fail
# it. Optional; absent = original behavior.
TASK_BLOCK=""
if [ -n "${JUDGE_TASK:-}" ] && [ -f "${JUDGE_TASK:-}" ]; then
  TASK_BLOCK="This deliverable is ONE STAGE of a larger plan. Its BINDING contract is the stage contract at $JUDGE_TASK — read it FIRST. Enforce the rubric(s) plus that stage contract's own 'Done when:' criteria. Project-level acceptance criteria that the stage map assigns to LATER stages (e.g. implementation criteria while judging a spec/plan stage) are NOT this deliverable's obligations — treat them as out of scope here, not as findings."
fi

# Deep Plan (Step 8): when the deliverable was produced under a conversational
# SPEC, verify it against that ORIGINAL contract too. With a stage contract
# present the SPEC becomes background context (criteria enforcement is scoped
# by the stage contract above); without one, original behavior: an unmet
# acceptance criterion is a blocking finding.
SPEC_BLOCK=""
if [ -n "${JUDGE_SPEC:-}" ] && [ -f "${JUDGE_SPEC:-}" ]; then
  if [ -n "$TASK_BLOCK" ]; then
    SPEC_BLOCK="The whole-project Deep Plan SPEC is at $JUDGE_SPEC — read it as background: judge whether this stage's output is CONSISTENT with it, but enforce acceptance criteria only as scoped by the stage contract."
  else
    SPEC_BLOCK="This deliverable was produced under a Deep Plan SPEC at $JUDGE_SPEC — read it and ALSO verify the deliverable satisfies every acceptance criterion in that SPEC; a criterion left unmet or untestable is a blocking finding."
  fi
fi

# Judge-scope fix (2026-07-12): when Nexus copies the task's actually-produced
# files next to the deliverable, 'evidence on the page' extends to them — the
# judge verifies claims against the real artifacts instead of refuting every
# claim it cannot see. Optional; absent = original behavior.
ART_BLOCK=""
if [ -n "${JUDGE_ARTIFACTS:-}" ] && [ -d "${JUDGE_ARTIFACTS:-}" ]; then
  ART_BLOCK="The task's actually-produced files are at $JUDGE_ARTIFACTS (read-only copies, size-capped). Before refuting any claim about a created/changed file, OPEN that file there and check — 'evidence on the page' extends to these artifacts. A claim the artifacts substantiate counts as verified even when the deliverable does not quote it inline (note the missing inline evidence as a LOW finding at most); a claim the artifacts contradict is CRITICAL."
fi

# Delta re-judge (2026-07-13): on rework round ≥2 Nexus passes the previous
# round's blocker findings + a unified diff of previous vs current version
# (env JUDGE_PRIOR, round number in JUDGE_ROUND). The judge then verifies the
# fix-list and scans only changed regions — the criteria set is FROZEN at
# round 1, which kills cross-round finding churn. Optional; absent = full
# original single-round behavior.
DELTA_BLOCK=""
if [ -n "${JUDGE_PRIOR:-}" ] && [ -f "${JUDGE_PRIOR:-}" ]; then
  DELTA_BLOCK="This is DELTA RE-JUDGE round ${JUDGE_ROUND:-2} of a rework. $JUDGE_PRIOR contains the previous round's blocker findings [F1..Fn] and a unified diff of the previous vs current version; the deliverable's '## Fixes applied' section claims what changed. THIS round: (1) verify each prior blocker is actually fixed — quote the fixed line; unfixed or regressed = still a blocker; (2) scan ONLY the changed regions shown in the diff for NEW blockers at critical/high severity; (3) the criteria set is FROZEN at round 1 — do not add new criteria, do not re-litigate unchanged text you passed before; new notes on unchanged text are forbidden. Verdict rule unchanged: SHIP when zero blockers remain."
fi

PROMPT="You are the frontier judge — a second, stronger model reviewing work produced by a weaker one. Judge the deliverable at $FILE against the rubric at $RUBRIC. $TYPE_RUBRIC_BLOCK $TASK_BLOCK $SPEC_BLOCK $ART_BLOCK $DELTA_BLOCK

Stance: REFUTE BY DEFAULT — scoped to FACTUAL CLAIMS inside this deliverable's binding contract. The deliverable's own assertions and self-scores are never evidence. You cannot run its commands, so judge the EVIDENCE ON THE PAGE: a load-bearing conclusion must rest on cited primary evidence (exact file:line, command + quoted output, source + date) on the page or in the artifacts directory. A conclusion resting on a proxy inference ('tests pass' therefore 'code healthy') or on unlocated hand-waving fails its gate, no matter how plausible it reads. Do NOT extend refutation into taste: flag ONLY gaps that affect correctness or the binding contract's stated criteria — polish, style, extra depth, and improvements beyond the contract are NOTES (severity medium/low), never blockers. A reviewer prompted to find gaps will usually report some even when the work is sound; do not manufacture findings to appear thorough. Check claims tagged '[UNSURE: reason]' FIRST — the author flagged them as unconfirmed; a marked claim that proves false is a medium finding, an UNMARKED claim that proves false is critical (it was presented as verified).

Steps:
1. Read $FILE, $RUBRIC, $KNOW/BUSINESS-CONTEXT.md, and $KNOW/STYLE-VOICE.md (plus the stage contract, the type rubric, and the Deep Plan SPEC if named above; browse the artifacts directory as needed to verify claims).
2. Must-pass gates: render ONE table covering every gate of every rubric read — | gate | PASS / FAIL / N-A (owned by a later stage) / UNVERIFIABLE-HERE (evidence cannot exist on the page for this deliverable type and the artifacts neither confirm nor contradict it) | one-line reason |. No partial credit on PASS/FAIL. UNVERIFIABLE-HERE is a note, not a FAIL, unless the binding contract explicitly requires that evidence inline.
3. Scored dimensions: score each 0-4 with a one-line justification.
4. Kill-list scan: quote any hits verbatim.
5. Top 3 highest-leverage improvements — concrete edits (quote the before, give the after), not vibes.
6. VERDICT: SHIP | REVISE (list exactly what blocks) | REWRITE (why salvaging is worse than restarting). BLOCKERS are only: a binding in-scope must-pass gate at FAIL, or a critical/high finding — an unmarked factually-false claim, a contradiction with the stage contract/SPEC, or a binding 'Done when:' criterion not met. SHIP when zero blockers exist, even with medium/low findings open — record those as notes; they do not trigger rework. REVISE requires at least one blocker; the revision_brief lists only blockers.
7. One 'Learning note:' line for the junior humans — the single most instructive gap between this and professional work.
8. END the reply with exactly one JSON object between these sentinel lines, nothing after the closing sentinel:
NEXUS_JUDGE_JSON_BEGIN
{\"verdict\": \"SHIP|REVISE|REWRITE\",
 \"findings\": [{\"severity\": \"critical|high|medium|low\", \"file_path\": \"deliverable.md\", \"line_no\": 12, \"line_text\": \"verbatim quote of that line (<=200)\", \"problem\": \"what is wrong (<=300)\", \"fix\": \"concrete edit (<=300)\"}],
 \"revision_brief\": \"<=2500 chars — a NUMBERED fix-list [F1]..[Fn], one entry per blocker finding in findings order: the exact edit needed, highest priority first\"}
NEXUS_JUDGE_JSON_END
Findings most severe first, at most 15; line_no/line_text must quote a real line of the deliverable or be null.

Be adversarial and specific. Do NOT rewrite the whole deliverable. Do NOT modify any files."

# Nexus Settings v2 hooks (both optional, absent = original behavior):
#   JUDGE_MODEL              — explicit judge model (Settings → Models & routing,
#                              'frontier judge' purpose) → claude --model
#   JUDGE_ANTHROPIC_API_KEY  — per-user Anthropic key; when set, the call runs
#                              key-authed instead of the CLI's subscription auth
MODEL_ARGS=()
if [ -n "${JUDGE_MODEL:-}" ]; then MODEL_ARGS=(--model "$JUDGE_MODEL"); fi

KEY_ENV=(-u ANTHROPIC_API_KEY)
if [ -n "${JUDGE_ANTHROPIC_API_KEY:-}" ]; then
  KEY_ENV=(ANTHROPIC_API_KEY="$JUDGE_ANTHROPIC_API_KEY")
fi

# NOTE: env requires -u options BEFORE NAME=VALUE assignments — KEY_ENV
# (either `-u ANTHROPIC_API_KEY` or `ANTHROPIC_API_KEY=…`) must come last.
exec env -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES -u ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES \
  -u CLAUDE_CONFIG_DIR -u CLAUDE_CODE_SUBAGENT_MODEL -u CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY \
  -u CLAUDE_CODE_EFFORT_LEVEL -u CLAUDE_CODE_AUTO_COMPACT_WINDOW -u CLAUDE_CODE_WORKFLOWS \
  -u CLAUDE_CODE_ALWAYS_ENABLE_EFFORT -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -u API_TIMEOUT_MS \
  -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT \
  "${KEY_ENV[@]}" \
  claude "${MODEL_ARGS[@]}" --output-format json -p "$PROMPT"
# Nexus C3 (Appendix C, contract C-8): --output-format json wraps the reply in a
# JSON envelope {result, usage, total_cost_usd, modelUsage}. The judge's sentinel
# block rides INSIDE .result; evals.run_judge_cmd unwraps .result before
# parse_judge_metrics and books usage/$ into the full-cost ledger.

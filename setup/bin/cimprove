#!/usr/bin/env bash
# cimprove — EVAL-DRIVEN IMPROVEMENT: frontier Claude reads an eval run's
# low-scoring cases (fixed brief + generated deliverable + the judge's critique
# with failed gates) and proposes a FEW durable config changes that would fix
# the RECURRING failures: knowledge-file edits, specialist standing-rule edits,
# or promoting a strong result into the domain's examples/ folder.
# Item 6c (2026-07-12) — sibling of cdistill; parsed by evals.parse_improve_deltas.
#
# Usage: cimprove <domain> <evidence_file>
#   <domain>         domain slug (knowledge files under ~/knowledge/domains/<d>/)
#   <evidence_file>  text file built by evals.gather_improve_evidence
set -euo pipefail

KNOW="$HOME/knowledge"
AGENTS="$HOME/.hermes/agents"
DOMAIN="${1:-}"; EVID="${2:-}"

if [ -z "$DOMAIN" ] || [ -z "$EVID" ]; then
  echo "usage: cimprove <domain> <evidence_file>" >&2
  exit 1
fi
EVID="$(realpath "$EVID")"
[ -f "$EVID" ] || { echo "cimprove: no such evidence file: $EVID" >&2; exit 1; }

DDIR="$KNOW/domains/$DOMAIN"
FILE_LINES=""
for f in STYLE-VOICE.md PLAYBOOK.md RUBRIC.md; do
  [ -f "$DDIR/$f" ] && FILE_LINES="$FILE_LINES $DDIR/$f"
  [ -f "$KNOW/$f" ] && FILE_LINES="$FILE_LINES $KNOW/$f"
done

PROMPT="You are improving an AI content system using its OWN eval results for the '$DOMAIN' domain. The evidence file contains, for each LOW-SCORING eval case: the fixed brief, the generated deliverable, and the frontier judge's critique with failed rubric gates (plus one-line summaries of the SHIP-quality cases, flagged as exemplar candidates).

READ the evidence file first: $EVID
THEN read the current config you may amend: the knowledge files$FILE_LINES and any specialist definition named in the evidence under $AGENTS/<name>.md (standing rules live below the frontmatter).

Your job: propose the FEWEST durable changes that would fix the RECURRING failures — never one-off rewrites of a single deliverable. Three kinds of change:
- kind 'knowledge': edit PLAYBOOK.md / RUBRIC.md / STYLE-VOICE.md (a rule to add, a gate to tighten, a voice guideline).
- kind 'specialist': edit one specialist's standing rules (name it; edit the body text, NEVER the frontmatter).
- kind 'exemplar': promote a SHIP-quality case's deliverable into the domain's examples/ folder (agents imitate those) — name its case_id.

OUTPUT: narrate briefly if you wish, then END with exactly one JSON object between these sentinel lines, nothing after the closing sentinel:
NEXUS_IMPROVE_JSON_BEGIN
{\"deltas\": [{
   \"kind\": \"knowledge|specialist|exemplar\",
   \"file\": \"PLAYBOOK.md|RUBRIC.md|STYLE-VOICE.md (kind=knowledge only)\",
   \"specialist\": \"<specialist name> (kind=specialist only)\",
   \"case_id\": \"<eval case id> (kind=exemplar only)\",
   \"before\": \"<current text this replaces, or '' for a pure addition> (<=500)\",
   \"after\": \"<the exact new/edited text> (<=800)\",
   \"rationale\": \"<why — cite the judge critique lines> (<=400)\",
   \"expected_effect\": \"<which eval gates/scores this should move> (<=200)\"
}]}
NEXUS_IMPROVE_JSON_END

RULES: at most 5 deltas; a delta must generalize across at least 2 cases OR fix a failed rubric gate; prefer tightening an existing rule over adding a vague new one; if the results support no durable change, return an empty deltas array. Do NOT modify any files yourself — you only PROPOSE; the operator reviews and applies."

# Nexus Settings v2 hooks (both optional, absent = original behavior):
#   JUDGE_MODEL / JUDGE_ANTHROPIC_API_KEY — frontier model + per-user key
MODEL_ARGS=()
if [ -n "${JUDGE_MODEL:-}" ]; then MODEL_ARGS=(--model "$JUDGE_MODEL"); fi

KEY_ENV=(-u ANTHROPIC_API_KEY)
if [ -n "${JUDGE_ANTHROPIC_API_KEY:-}" ]; then
  KEY_ENV=(ANTHROPIC_API_KEY="$JUDGE_ANTHROPIC_API_KEY")
fi

# Read-only proposal: no Edit/Write tools — the operator approves, then Nexus applies.
exec env -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES -u ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES \
  -u CLAUDE_CONFIG_DIR -u CLAUDE_CODE_SUBAGENT_MODEL -u CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY \
  -u CLAUDE_CODE_EFFORT_LEVEL -u CLAUDE_CODE_AUTO_COMPACT_WINDOW -u CLAUDE_CODE_WORKFLOWS \
  -u CLAUDE_CODE_ALWAYS_ENABLE_EFFORT -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -u API_TIMEOUT_MS \
  -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT \
  "${KEY_ENV[@]}" \
  claude "${MODEL_ARGS[@]}" \
    --permission-mode acceptEdits \
    --allowedTools "Read" "Grep" "Glob" \
    --disallowedTools "Bash" "Edit" "Write" "Bash(git push:*)" "Bash(gh:*)" \
    -p "$PROMPT"

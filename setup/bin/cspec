#!/usr/bin/env bash
# cspec — frontier Claude interviews you and writes SPEC.md for the current repo.
# Part of the GLM<->Claude bridge (docs: ~/knowledge/WORKFLOW.md).
# Usage: cspec "build a password reset flow"
set -euo pipefail

GOAL="${*:-}"
[ -z "$GOAL" ] && GOAL="<not given - interview me to find out what we are building>"

PROMPT="Write a SPEC.md for this repository. Goal: $GOAL

Process:
1. Look at the repo briefly (structure, stack, conventions) so the spec is grounded in reality. If the task is product/business-facing and ~/knowledge/BUSINESS-CONTEXT.md exists, read it first.
2. Interview me with BATCHED questions (use AskUserQuestion where options fit): goal, users, constraints, success criteria, explicit out-of-scope. Ask only what materially changes the design.
3. Write SPEC.md at the repo root with sections: ## Context & goal · ## Requirements (numbered, each independently testable) · ## Files / interfaces (specific paths) · ## Out of scope · ## Verification (exact commands + expected results). Show me the draft and get my confirmation before saving.

CRITICAL: this spec will be implemented by a WEAKER model (GLM-5.2). Therefore: requirements must be unambiguous and mechanically checkable; name every edge case explicitly (empty, invalid, concurrent, failure paths, limits); specify exact file paths and interfaces; keep scope minimal — a small spec done right beats a big one done vaguely. The implementer must never need to guess."

# Clean environment: strip GLM/Z.ai redirection + nested-session vars so this always
# reaches the real Anthropic endpoint with the user's subscription, even when invoked
# from inside a `glm` session or a Hermes terminal.
exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
  -u ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES -u ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES \
  -u CLAUDE_CONFIG_DIR -u CLAUDE_CODE_SUBAGENT_MODEL -u CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY \
  -u CLAUDE_CODE_EFFORT_LEVEL -u CLAUDE_CODE_AUTO_COMPACT_WINDOW -u CLAUDE_CODE_WORKFLOWS \
  -u CLAUDE_CODE_ALWAYS_ENABLE_EFFORT -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -u API_TIMEOUT_MS \
  -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT \
  claude "$PROMPT"

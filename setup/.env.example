# ─────────────────────────────────────────────────────────────────────────
# Hermes Team Setup — environment template
# Copy this file to  ~/.hermes/.env  and fill in YOUR OWN keys.
# NEVER commit the real ~/.hermes/.env — it holds live secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Primary model (REQUIRED) — GLM-5.2 via the Z.AI coding plan ───────────
GLM_API_KEY=                 # your Z.AI / GLM key — https://z.ai
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# ── Web search (recommended) — Brave Search API ──────────────────────────
BRAVE_SEARCH_API_KEY=        # https://brave.com/search/api/

# ── Observability (optional) — self-hosted Langfuse (docker in ../infra) ──
HERMES_LANGFUSE_PUBLIC_KEY=
HERMES_LANGFUSE_SECRET_KEY=
HERMES_LANGFUSE_BASE_URL=http://localhost:3000
HERMES_LANGFUSE_ENV=production

# ── Nexus dashboard auth — set these to any strong random strings ────────
API_SERVER_ENABLED=true
API_SERVER_KEY=              # e.g. `openssl rand -hex 32`
JARVIS_HUD_TOKEN=            # e.g. `openssl rand -hex 32`

# ── Optional extras (leave blank unless you use them) ────────────────────
SUPERMEMORY_API_KEY=
BROWSERBASE_ADVANCED_STEALTH=
BROWSERBASE_PROXIES=
BROWSER_INACTIVITY_TIMEOUT=
BROWSER_SESSION_TIMEOUT=
TERMINAL_LIFETIME_SECONDS=
TERMINAL_MODAL_IMAGE=
TERMINAL_TIMEOUT=

# ── Debug flags (optional) ───────────────────────────────────────────────
IMAGE_TOOLS_DEBUG=
MOA_TOOLS_DEBUG=
VISION_TOOLS_DEBUG=
WEB_TOOLS_DEBUG=

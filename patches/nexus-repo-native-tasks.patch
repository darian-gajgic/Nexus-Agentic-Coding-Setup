 }
+
+/* ═══ JARVIS v2 — holographic stage (2026-07-07) ═══ */
+.jarvis-stage {
+  position:relative; width:100%; flex:1; min-height:56vh;
+  display:flex; align-items:center; justify-content:center;
+  border-radius:16px; overflow:hidden;
+  background:radial-gradient(ellipse at 50% 65%, rgba(34,211,238,.06), transparent 60%), #05050b;
+  border:1px solid rgba(124,92,255,.16);
+  box-shadow:inset 0 0 80px rgba(7,7,13,.9);
+}
+.jarvis-stage .stage-center { position:relative; z-index:3; }
+.jarvis-stage .reactor-wrap { width:min(52vh,460px); height:min(52vh,460px); }
+.jarvis-stage .stage-controls {
+  position:absolute; top:14px; right:16px; z-index:4;
+  background:rgba(13,13,26,.6); border:1px solid rgba(124,92,255,.22);
+  border-radius:12px; padding:8px 14px; backdrop-filter:blur(10px);
+}
+/* holographic identity treatment on the face */
+.jarvis-stage .avatar-wrap { box-shadow:0 0 60px rgba(34,211,238,.25), 0 0 120px rgba(124,92,255,.15); }
+.jarvis-stage .avatar-wrap .holo-scan {
+  position:absolute; inset:0; z-index:5; border-radius:inherit; pointer-events:none;
+  background:repeating-linear-gradient(180deg, rgba(94,234,212,.05) 0 1px, transparent 1px 4px);
+  mix-blend-mode:screen; animation:holoScan 7s linear infinite;
+}
+@keyframes holoScan { 0% { background-position-y:0; } 100% { background-position-y:120px; } }
+.jarvis-stage .avatar-reactor-row { animation:holoFloat 9s ease-in-out infinite; }
+@keyframes holoFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-9px); } }
+.jarvis-feed { max-height:20vh; }
+
+/* ═══ Dashboard memory-galaxy hero (v3) ═══ */
+.hero-3d { height:44vh; min-height:340px; transition:height .55s cubic-bezier(.2,.8,.2,1); }
+.hero-3d.expanded { height:calc(100vh - 150px); }
+.hero-expand {
+  position:absolute; top:12px; right:12px; z-index:6; width:34px; height:34px;
+  border-radius:9px; border:1px solid rgba(124,92,255,.35); cursor:pointer;
+  background:rgba(13,13,26,.65); color:var(--text-dim); font-size:16px;
+  backdrop-filter:blur(8px); transition:all .2s;
+}
+.hero-expand:hover { color:var(--text); border-color:var(--accent); box-shadow:0 0 14px rgba(124,92,255,.35); }
+
+/* ═══ Guided help tours ═══ */
+.tour-dim { position:fixed; inset:0; z-index:1200; pointer-events:auto; }
+.tour-spot {
+  position:fixed; z-index:1201; border-radius:12px; pointer-events:none;
+  box-shadow:0 0 0 4000px rgba(4,4,10,.78), 0 0 24px rgba(124,92,255,.55);
+  border:1.5px solid rgba(124,92,255,.9); transition:all .35s cubic-bezier(.2,.8,.2,1);
+}
+.tour-card {
+  position:fixed; z-index:1202; width:360px; max-width:92vw; padding:16px 18px;
+  background:rgba(15,15,30,.97); border:1px solid rgba(124,92,255,.45);
+  border-radius:14px; box-shadow:0 14px 50px rgba(0,0,0,.6);
+  transition:all .35s cubic-bezier(.2,.8,.2,1);
+}
+.tour-card h3 { font-size:14.5px; margin-bottom:7px; color:var(--text); }
+.tour-card p { font-size:12.8px; line-height:1.6; color:var(--text-dim); margin-bottom:12px; }
+.tour-card .tour-nav { display:flex; align-items:center; gap:8px; }
+.tour-card .tour-step-n { font-family:var(--font-mono); font-size:10.5px; color:var(--text-faint); margin-right:auto; }
+.help-btn {
+  width:30px; height:30px; border-radius:50%; border:1px solid rgba(124,92,255,.4);
+  background:rgba(20,20,36,.7); color:var(--text-dim); cursor:pointer; font-weight:700;
+  font-size:14px; transition:all .2s;
+}
+.help-btn:hover { color:#fff; border-color:var(--accent); box-shadow:0 0 12px rgba(124,92,255,.4); }
+
+/* ═══ Manual tab ═══ */
+.manual-wrap { max-width:980px; }
+.manual-toc { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px; }
+.manual-toc a {
+  padding:6px 12px; border-radius:20px; border:1px solid var(--border);
+  color:var(--text-dim); text-decoration:none; font-size:12px; transition:all .2s;
+}
+.manual-toc a:hover { border-color:var(--accent); color:var(--text); }
+.manual-sec { margin-bottom:34px; }
+.manual-sec h2 { font-size:19px; margin-bottom:4px; }
+.manual-sec .m-sub { color:var(--text-dim); font-size:12.5px; margin-bottom:14px; }
+.manual-sec h4 { font-size:13.5px; margin:16px 0 6px; color:var(--accent-2); }
+.manual-sec p, .manual-sec li { font-size:13px; line-height:1.75; color:var(--text-dim); }
+.manual-sec li { margin-left:18px; margin-bottom:4px; }
+.manual-sec b { color:var(--text); }
+.m-steps { counter-reset:step; margin:10px 0; }
+.m-step { display:flex; gap:12px; padding:10px 0; border-bottom:1px dashed rgba(148,148,190,.12); }
+.m-step::before {
+  counter-increment:step; content:counter(step); flex:0 0 26px; height:26px;
+  border-radius:50%; background:rgba(124,92,255,.18); border:1px solid rgba(124,92,255,.5);
+  display:flex; align-items:center; justify-content:center;
+  font-family:var(--font-mono); font-size:12px; color:var(--accent-2);
+}
+.m-step div { font-size:13px; line-height:1.65; color:var(--text-dim); }
+.m-visual {
+  border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin:10px 0;
+  background:rgba(10,10,20,.5); font-family:var(--font-mono); font-size:11.5px;
+  color:var(--text-dim); white-space:pre; overflow-x:auto; line-height:1.7;
+}
+.m-tip {
+  border-left:3px solid var(--accent-2); background:rgba(94,234,212,.06);
+  padding:10px 14px; border-radius:0 10px 10px 0; margin:10px 0; font-size:12.5px;
+  color:var(--text-dim); line-height:1.6;
+}
+.modal { position:relative; }
+.modal-help { position:absolute; top:14px; right:14px; z-index:5; }
+
+/* ═══ Global focus context (Projects › Workflows › Tasks scoping) ═══ */
+.focus-bar {
+  display:flex; align-items:center; gap:8px; padding:7px 30px;
+  background:rgba(124,92,255,.07); border-bottom:1px solid rgba(124,92,255,.18);
+  font-size:12px; color:var(--text-dim);
+}
+.focus-chip {
+  display:inline-flex; align-items:center; gap:6px; padding:3px 10px;
+  border-radius:14px; border:1px solid rgba(124,92,255,.4);
+  background:rgba(20,20,36,.7); color:var(--text); font-size:12px;
+}
+.focus-chip b { font-weight:600; }
+.focus-chip .fx {
+  cursor:pointer; color:var(--text-faint); font-weight:700; padding:0 2px;
+}
+.focus-chip .fx:hover { color:var(--red, #f87171); }
+.focus-sep { color:var(--text-faint); }
+.focus-btn {
+  border:1px solid rgba(124,92,255,.35); background:rgba(20,20,36,.6);
+  color:var(--text-dim); border-radius:8px; padding:2px 8px; cursor:pointer;
+  font-size:11px; transition:all .15s;
+}
+.focus-btn:hover { color:var(--text); border-color:var(--accent); }
+
+/* ═══ Result review (PR-style comparison for every output type) ═══ */
+.review-layout { display:flex; gap:14px; min-height:380px; max-height:62vh; }
+.review-files {
+  flex:0 0 250px; overflow-y:auto; border-right:1px solid var(--border);
+  padding-right:10px; display:flex; flex-direction:column; gap:2px;
+}
+.review-file {
+  display:flex; align-items:center; gap:6px; padding:6px 8px; border-radius:8px;
+  cursor:pointer; font-size:11.5px; font-family:var(--font-mono);
+  color:var(--text-dim); border:1px solid transparent;
+}
+.review-file:hover { background:rgba(124,92,255,.08); }
+.review-file.active { background:rgba(124,92,255,.14); border-color:rgba(124,92,255,.4); color:var(--text); }
+.review-file .rf-path { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.rf-add { color:#4ade80; } .rf-del { color:#f87171; }
+.review-pane { flex:1; overflow:auto; }
+.diff-hunk { margin-bottom:14px; border:1px solid var(--border); border-radius:10px; overflow:hidden; }
+.diff-hunk-head {
+  font-family:var(--font-mono); font-size:10.5px; color:var(--accent-2);
+  background:rgba(94,234,212,.06); padding:4px 10px; border-bottom:1px solid var(--border);
+}
+.diff-line { display:flex; font-family:var(--font-mono); font-size:11.5px; line-height:1.6; }
+.diff-line pre { margin:0; padding:0 10px; white-space:pre-wrap; word-break:break-all; flex:1; }
+.diff-line.add { background:rgba(74,222,128,.10); } .diff-line.add .diff-sign { color:#4ade80; }
+.diff-line.del { background:rgba(248,113,113,.10); } .diff-line.del .diff-sign { color:#f87171; }
+.diff-sign { flex:0 0 22px; text-align:center; color:var(--text-faint); user-select:none; }
+.review-stat { font-family:var(--font-mono); font-size:11px; }
+
+/* ═══ Block 1: Login screen + user chip (multi-user) ═══ */
+#loginScreen {
+  position:fixed; inset:0; z-index:2000; display:flex; align-items:center;
+  justify-content:center; padding:20px;
+}
+.login-card {
+  width:min(360px, 94vw); padding:30px 26px; border-radius:var(--radius);
+  background:var(--panel); border:1px solid var(--border);
+  backdrop-filter:blur(18px); box-shadow:var(--shadow);
+}
+.login-err {
+  margin-top:12px; padding:8px 10px; border-radius:8px; font-size:12px;
+  color:#fca5a5; background:rgba(248,113,113,.12); border:1px solid rgba(248,113,113,.3);
+}
+.user-chip {
+  display:flex; align-items:center; gap:7px; padding:3px 6px 3px 3px;
+  border:1px solid var(--border); border-radius:99px; background:rgba(20,20,32,.55);
+}
+.user-avatar {
+  width:22px; height:22px; border-radius:50%; display:flex; align-items:center;
+  justify-content:center; font-size:11px; font-weight:700; color:#fff;
+  background:linear-gradient(135deg, var(--accent), var(--cyan));
+}
+.user-name { font-size:11.5px; color:var(--text-dim); max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.user-logout {
+  border:none; background:none; color:var(--text-faint); cursor:pointer;
+  font-size:13px; padding:2px 4px; border-radius:6px;
+}
+.user-logout:hover { color:var(--red, #f87171); background:rgba(248,113,113,.12); }
+
+/* ═══ Block 1: Mobile layout pass ═══ */
+.menu-btn {
+  display:none; border:1px solid var(--border); background:rgba(20,20,32,.55);
+  color:var(--text-dim); border-radius:10px; width:34px; height:34px;
+  align-items:center; justify-content:center; cursor:pointer; flex:0 0 auto;
+}
+.sidebar-scrim {
+  display:none; position:fixed; inset:0; z-index:1150;  /* under .sidebar (1200), above .main */
+  background:rgba(4,4,10,.55); backdrop-filter:blur(2px);
+}
+@media (max-width: 900px) {
+  .menu-btn { display:flex; }
+  .sidebar {
+    position:fixed; left:0; top:0; bottom:0; z-index:1200;
+    transform:translateX(-104%); transition:transform .22s ease;
+    box-shadow:0 0 40px rgba(0,0,0,.5);
+  }
+  .sidebar.open { transform:none; }
+  body.nav-open .sidebar-scrim { display:block; }
+  .main { width:100vw; }
+  .content { padding:14px 12px; }
+  .topbar { padding:10px 12px; gap:8px; flex-wrap:wrap; }
+  .topbar-title h1 { font-size:17px; }
+  .page-sub, #modelStrip, #liveClock { display:none !important; }
+  .topbar-right { gap:8px; }
+  .stat-grid { grid-template-columns:1fr 1fr; }
+  .dash-row, .monitor-grid, .agent-grid, .agentic-grid, .spec-grid { grid-template-columns:1fr !important; }
+  .modal { min-width:0 !important; width:96vw !important; max-width:96vw !important; max-height:92vh; overflow-y:auto; }
+  .drawer { width:100vw; max-width:100vw; }
+  .kanban-board { height:calc(100dvh - 220px); }
+  .kanban-col { min-width:78vw; }
+  .toasts { left:10px; right:10px; }
+  .toast { max-width:none; }
+  .focus-bar { flex-wrap:wrap; padding:6px 12px; }
+  .btn-primary, .btn-ghost { min-height:34px; }
+  .user-name { max-width:70px; }
+}
+@media (max-width: 520px) {
+  .stat-grid { grid-template-columns:1fr 1fr; gap:8px; }
+  #spawnBtn { display:none; }  /* fleet management is a desktop task */
+}

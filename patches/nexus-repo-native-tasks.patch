 }
+
+/* ═══ JARVIS v2 — holographic stage (2026-07-07) ═══ */
+.jarvis-stage {
+  position:relative; width:100%; flex:1; min-height:56vh;
+  display:flex; align-items:center; justify-content:center;
+  border-radius:16px; overflow:hidden;
+  background:radial-gradient(ellipse at 50% 65%, rgba(34,211,238,.06), transparent 60%), #05050b;
+  border:1px solid rgba(124,92,255,.16);
+  box-shadow:inset 0 0 80px rgba(7,7,13,.9);
+}
+.jarvis-stage .stage-center { position:relative; z-index:3; }
+.jarvis-stage .reactor-wrap { width:min(52vh,460px); height:min(52vh,460px); }
+.jarvis-stage .stage-controls {
+  position:absolute; top:14px; right:16px; z-index:4;
+  background:rgba(13,13,26,.6); border:1px solid rgba(124,92,255,.22);
+  border-radius:12px; padding:8px 14px; backdrop-filter:blur(10px);
+}
+/* holographic identity treatment on the face */
+.jarvis-stage .avatar-wrap { box-shadow:0 0 60px rgba(34,211,238,.25), 0 0 120px rgba(124,92,255,.15); }
+.jarvis-stage .avatar-wrap .holo-scan {
+  position:absolute; inset:0; z-index:5; border-radius:inherit; pointer-events:none;
+  background:repeating-linear-gradient(180deg, rgba(94,234,212,.05) 0 1px, transparent 1px 4px);
+  mix-blend-mode:screen; animation:holoScan 7s linear infinite;
+}
+@keyframes holoScan { 0% { background-position-y:0; } 100% { background-position-y:120px; } }
+.jarvis-stage .avatar-reactor-row { animation:holoFloat 9s ease-in-out infinite; }
+@keyframes holoFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-9px); } }
+.jarvis-feed { max-height:20vh; }
+
+/* ═══ Dashboard memory-galaxy hero (v3) ═══ */
+.hero-3d { height:44vh; min-height:340px; transition:height .55s cubic-bezier(.2,.8,.2,1); }
+.hero-3d.expanded { height:calc(100vh - 150px); }
+.hero-expand {
+  position:absolute; top:12px; right:12px; z-index:6; width:34px; height:34px;
+  border-radius:9px; border:1px solid rgba(124,92,255,.35); cursor:pointer;
+  background:rgba(13,13,26,.65); color:var(--text-dim); font-size:16px;
+  backdrop-filter:blur(8px); transition:all .2s;
+}
+.hero-expand:hover { color:var(--text); border-color:var(--accent); box-shadow:0 0 14px rgba(124,92,255,.35); }
+
+/* ═══ Guided help tours ═══ */
+.tour-dim { position:fixed; inset:0; z-index:1200; pointer-events:auto; }
+.tour-spot {
+  position:fixed; z-index:1201; border-radius:12px; pointer-events:none;
+  box-shadow:0 0 0 4000px rgba(4,4,10,.78), 0 0 24px rgba(124,92,255,.55);
+  border:1.5px solid rgba(124,92,255,.9); transition:all .35s cubic-bezier(.2,.8,.2,1);
+}
+.tour-card {
+  position:fixed; z-index:1202; width:360px; max-width:92vw; padding:16px 18px;
+  background:rgba(15,15,30,.97); border:1px solid rgba(124,92,255,.45);
+  border-radius:14px; box-shadow:0 14px 50px rgba(0,0,0,.6);
+  transition:all .35s cubic-bezier(.2,.8,.2,1);
+}
+.tour-card h3 { font-size:14.5px; margin-bottom:7px; color:var(--text); }
+.tour-card p { font-size:12.8px; line-height:1.6; color:var(--text-dim); margin-bottom:12px; }
+.tour-card .tour-nav { display:flex; align-items:center; gap:8px; }
+.tour-card .tour-step-n { font-family:var(--font-mono); font-size:10.5px; color:var(--text-faint); margin-right:auto; }
+.help-btn {
+  width:30px; height:30px; border-radius:50%; border:1px solid rgba(124,92,255,.4);
+  background:rgba(20,20,36,.7); color:var(--text-dim); cursor:pointer; font-weight:700;
+  font-size:14px; transition:all .2s;
+}
+.help-btn:hover { color:#fff; border-color:var(--accent); box-shadow:0 0 12px rgba(124,92,255,.4); }
+
+/* ═══ Manual tab ═══ */
+.manual-wrap { max-width:980px; }
+.manual-toc { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px; }
+.manual-toc a {
+  padding:6px 12px; border-radius:20px; border:1px solid var(--border);
+  color:var(--text-dim); text-decoration:none; font-size:12px; transition:all .2s;
+}
+.manual-toc a:hover { border-color:var(--accent); color:var(--text); }
+.manual-sec { margin-bottom:34px; }
+.manual-sec h2 { font-size:19px; margin-bottom:4px; }
+.manual-sec .m-sub { color:var(--text-dim); font-size:12.5px; margin-bottom:14px; }
+.manual-sec h4 { font-size:13.5px; margin:16px 0 6px; color:var(--accent-2); }
+.manual-sec p, .manual-sec li { font-size:13px; line-height:1.75; color:var(--text-dim); }
+.manual-sec li { margin-left:18px; margin-bottom:4px; }
+.manual-sec b { color:var(--text); }
+.m-steps { counter-reset:step; margin:10px 0; }
+.m-step { display:flex; gap:12px; padding:10px 0; border-bottom:1px dashed rgba(148,148,190,.12); }
+.m-step::before {
+  counter-increment:step; content:counter(step); flex:0 0 26px; height:26px;
+  border-radius:50%; background:rgba(124,92,255,.18); border:1px solid rgba(124,92,255,.5);
+  display:flex; align-items:center; justify-content:center;
+  font-family:var(--font-mono); font-size:12px; color:var(--accent-2);
+}
+.m-step div { font-size:13px; line-height:1.65; color:var(--text-dim); }
+.m-visual {
+  border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin:10px 0;
+  background:rgba(10,10,20,.5); font-family:var(--font-mono); font-size:11.5px;
+  color:var(--text-dim); white-space:pre; overflow-x:auto; line-height:1.7;
+}
+.m-tip {
+  border-left:3px solid var(--accent-2); background:rgba(94,234,212,.06);
+  padding:10px 14px; border-radius:0 10px 10px 0; margin:10px 0; font-size:12.5px;
+  color:var(--text-dim); line-height:1.6;
+}
